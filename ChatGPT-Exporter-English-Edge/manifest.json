{
  "manifest_version": 3,
  "name": "ChatGPT Exporter — English Autopilot",
  "version": "2.4.1",
  "description": "Resumable ChatGPT and small Library file backup, manual large-file catalog, viewer metadata, adaptive checks and searchable activity logs.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ChatGPT Exporter"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
